# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.Rproj.user

# Temp files
Data/Temp/
R/debug.R

# Machine-local configuration (see secrets_example.yaml)
secrets.yaml
_targets.yaml

# Target stores
Data/Targets_data/*
!Data/Targets_data/.keep
_targets/

# Raw inputs and processed rasters of the template pipeline (large
#   downloads and generated products never go into git)
Data/Input/HWSD/
Data/Processed/CHELSA_V2.1/
Data/Processed/CHELSA_TraCE21k_V1.0/
Data/Processed/HWSD_v2.2/

# Private material (correspondence, personal details)
Private/
**/Private/

# Ignore all climate TIF files
Data/Input/Paleoclimate/*.tif
Data/Input/Neoclimate/**/*.tif

# Ignore large soil rasters
Data/Input/WoSIS/HWSD2.bil
Data/Processed/WoSIS/wosis_raster.tif
Data/Processed/WoSIS/resampled/wosis_raster.tif
